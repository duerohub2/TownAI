; Engine configuration file.
; AI Living City MVP — offline playable browser game.

config_version=5

[application]

boot_splash/show_image=false
boot_splash/bg_color=Color(0.043, 0.071, 0.125, 1)
config/name="AI Living City"
config/description="Playable offline isometric city life simulation MVP."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/template/characters/runner.png"

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=480
window/size/window_width_override=720
window/size/window_height_override=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[editor]
import/use_multiple_threads=false
